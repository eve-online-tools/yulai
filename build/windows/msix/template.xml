<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="yulai"
        Arguments=""
        InstallLocation="C:\Program Files\eve-online-tools\Yulai">
    </Installer>
    <PackageInformation
        PackageName="Yulai"
        PackageDisplayName="Yulai"
        PublisherName="CN=eve-online-tools"
        PublisherDisplayName="eve-online-tools"
        Version="0.1.0.0"
        PackageDescription="EVE Online tools">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="tools.eve-online.yulai"
                Description="EVE Online tools"
                DisplayName="Yulai"
                ExecutableName="yulai"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Yulai</DisplayName>
            <PublisherDisplayName>eve-online-tools</PublisherDisplayName>
            <Description>EVE Online tools</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="yulai.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
